const canvas = document.getElementById('canvas');
const clearButton = document.getElementById('clearButton');

let canvasWidth = 800;
let canvasHeight = 600;

let stars = [];
let flowDots = [];
let windows = [];
let time = 0;

function draw() {
    clearCanvas(canvas);

    stars = [];
    flowDots = [];
    windows = [];

    // =========================
    // 1. Background
    // =========================
    let background = createRectangle(0, 0, canvasWidth, canvasHeight, "rgb(10, 20, 60)");
    canvas.appendChild(background);

    // 轻微背景光层
    for (let i = 0; i < 8; i++) {
        let glow = createCircle(
            random(0, canvasWidth),
            random(0, canvasHeight * 0.65),
            random(60, 140),
            "rgba(60, 90, 180, 0.06)"
        );
        canvas.appendChild(glow);
    }

    // =========================
    // 2. Moon
    // =========================
    let moonX = 120;
    let moonY = 100;

    let moonGlow1 = createCircle(moonX, moonY, 50, "rgba(255,220,120,0.16)");
    let moonGlow2 = createCircle(moonX, moonY, 34, "rgba(255,235,180,0.28)");
    let moonCore = createCircle(moonX, moonY, 20, "rgb(255,225,130)");

    canvas.appendChild(moonGlow1);
    canvas.appendChild(moonGlow2);
    canvas.appendChild(moonCore);

    stars.push({
        glow1: moonGlow1,
        glow2: moonGlow2,
        core: moonCore,
        baseSize: 20,
        offset: 8
    });

    createHaloDots(moonX, moonY, 34, 24, "rgb(255,220,120)");
    createHaloDots(moonX, moonY, 48, 28, "rgb(255,235,170)");

    // =========================
    // 3. Big stars
    // =========================
    let bigStarPositions = [
        { x: 250, y: 90, size: 6 },
        { x: 340, y: 145, size: 5 },
        { x: 420, y: 70, size: 4.5 },
        { x: 600, y: 90, size: 6 },
        { x: 690, y: 150, size: 5 },
        { x: 740, y: 110, size: 4.5 }
    ];

    for (let i = 0; i < bigStarPositions.length; i++) {
        let s = bigStarPositions[i];

        let glow1 = createCircle(s.x, s.y, s.size * 2.6, "rgba(255,220,120,0.16)");
        let glow2 = createCircle(s.x, s.y, s.size * 1.6, "rgba(255,235,180,0.28)");
        let core = createCircle(s.x, s.y, s.size, "rgb(255,230,140)");

        canvas.appendChild(glow1);
        canvas.appendChild(glow2);
        canvas.appendChild(core);

        stars.push({
            glow1: glow1,
            glow2: glow2,
            core: core,
            baseSize: s.size,
            offset: random(0, 100)
        });

        createHaloDots(s.x, s.y, s.size * 3.1, 16, "rgb(255,220,120)");
    }

    // =========================
    // 4. Small stars
    // =========================
    for (let i = 0; i < 75; i++) {
        let x = random(20, canvasWidth - 20);
        let y = random(20, canvasHeight * 0.62);
        let size = random(1.1, 2.3);

        let star = createCircle(x, y, size, "rgb(220,230,255)");
        canvas.appendChild(star);

        stars.push({
            glow1: null,
            glow2: null,
            core: star,
            baseSize: size,
            offset: random(0, 100)
        });
    }

    // =========================
    // 5. Main swirl - 缩小主体 + 拉长尾部
    // =========================
    // 主体缩小
    createSwirlLine(500, 220, 130, 0, 1.12, 85, "rgb(255,210,110)");
    createSwirlLine(500, 220, 112, 34, 1.05, 78, "rgb(110,160,255)");
    createSwirlLine(500, 220, 96, 76, 0.98, 70, "rgb(255,235,150)");

    // 尾部延长，向右下方拖出去
    createTailSwirlLine(500, 220, 150, 118, 1.02, 88, "rgb(80,130,240)", 1.0, 0.55);
    createTailSwirlLine(500, 220, 175, 132, 0.95, 96, "rgb(255,210,110)", 1.15, 0.65);
    createTailSwirlLine(500, 220, 205, 142, 0.88, 105, "rgb(120,170,255)", 1.28, 0.72);

    // =========================
    // 6. More swirls - 新增 5 个小漩涡
    // =========================
    // 左侧
    createSwirlLine(255, 180, 72, 18, 1.28, 44, "rgb(120,170,255)");
    createSwirlLine(255, 180, 56, 74, 1.15, 36, "rgb(255,215,120)");

    // 右上
    createSwirlLine(675, 142, 60, 8, 1.30, 34, "rgb(255,225,130)");
    createSwirlLine(675, 142, 46, 58, 1.12, 28, "rgb(110,160,255)");

    // 新增小漩涡 1
    createSwirlLine(350, 120, 42, 12, 1.25, 24, "rgb(255,220,120)");
    createSwirlLine(350, 120, 30, 58, 1.06, 18, "rgb(100,150,255)");

    // 新增小漩涡 2
    createSwirlLine(585, 120, 38, 22, 1.18, 22, "rgb(255,235,150)");
    createSwirlLine(585, 120, 28, 70, 1.02, 16, "rgb(90,140,255)");

    // 新增小漩涡 3
    createSwirlLine(725, 205, 34, 16, 1.20, 20, "rgb(255,220,120)");
    createSwirlLine(725, 205, 24, 64, 1.00, 14, "rgb(120,170,255)");

    // 新增小漩涡 4
    createSwirlLine(160, 235, 36, 10, 1.22, 20, "rgb(110,160,255)");
    createSwirlLine(160, 235, 26, 62, 1.03, 14, "rgb(255,215,120)");

    // 新增小漩涡 5
    createSwirlLine(455, 85, 30, 18, 1.15, 18, "rgb(255,225,130)");
    createSwirlLine(455, 85, 20, 72, 0.98, 12, "rgb(110,160,255)");

    // =========================
    // 7. Ground / skyline base
    // =========================
    let groundBack = createRectangle(0, 470, 800, 130, "rgb(24, 30, 48)");
    canvas.appendChild(groundBack);

    let groundFront = createRectangle(0, 510, 800, 90, "rgb(16, 22, 36)");
    canvas.appendChild(groundFront);

    // =========================
    // 8. City skyline
    // =========================
    let cityBase = 520;

    let buildingData = [
        { x: 20,  w: 42, h: 80 },
        { x: 68,  w: 36, h: 115 },
        { x: 108, w: 52, h: 95 },
        { x: 166, w: 40, h: 145 },
        { x: 212, w: 58, h: 105 },
        { x: 278, w: 34, h: 175 },
        { x: 318, w: 48, h: 130 },
        { x: 372, w: 44, h: 92 },
        { x: 422, w: 60, h: 165 },
        { x: 490, w: 38, h: 118 },
        { x: 534, w: 54, h: 142 },
        { x: 594, w: 42, h: 100 },
        { x: 642, w: 52, h: 150 },
        { x: 700, w: 46, h: 122 },
        { x: 752, w: 30, h: 90 }
    ];

    for (let i = 0; i < buildingData.length; i++) {
        let b = buildingData[i];

        let building = createRectangle(
            b.x,
            cityBase - b.h,
            b.w,
            b.h,
            "rgb(24, 28, 42)"
        );
        canvas.appendChild(building);

        if (i % 3 === 0) {
            let topBox = createRectangle(
                b.x + b.w * 0.25,
                cityBase - b.h - 10,
                b.w * 0.5,
                10,
                "rgb(18, 22, 34)"
            );
            canvas.appendChild(topBox);
        }

        if (i % 4 === 0) {
            let antenna = createRectangle(
                b.x + b.w / 2 - 1,
                cityBase - b.h - 20,
                2,
                20,
                "rgb(60, 70, 90)"
            );
            canvas.appendChild(antenna);
        }

        let cols = Math.floor((b.w - 8) / 10);
        let rows = Math.floor((b.h - 10) / 14);

        for (let row = 0; row < rows; row++) {
            for (let col = 0; col < cols; col++) {
                if (Math.random() > 0.42) {
                    let wx = b.x + 4 + col * 10;
                    let wy = cityBase - b.h + 8 + row * 14;

                    let windowLight = createRectangle(
                        wx,
                        wy,
                        4,
                        6,
                        "rgb(255,220,120)"
                    );
                    canvas.appendChild(windowLight);

                    windows.push({
                        element: windowLight,
                        baseWidth: 4,
                        baseHeight: 6,
                        offset: random(0, 100)
                    });
                }
            }
        }
    }
}

// =========================
// Halo dots
// =========================
function createHaloDots(centerX, centerY, radius, dotCount, color) {
    for (let i = 0; i < dotCount; i++) {
        let angle = (360 / dotCount) * i;
        let point = getPointOnCircle(centerX, centerY, radius + random(-3, 3), angle);
        let size = random(1.1, 2.3);

        let dot = createCircle(point.x, point.y, size, color);
        canvas.appendChild(dot);

        flowDots.push({
            element: dot,
            type: "halo",
            centerX: centerX,
            centerY: centerY,
            baseRadius: radius,
            baseAngle: angle,
            offset: random(0, 100),
            baseSize: size
        });
    }
}

// =========================
// Swirl line made of dots
// =========================
function createSwirlLine(centerX, centerY, maxRadius, angleOffset, spiralTightness, dotCount, color) {
    for (let i = 0; i < dotCount; i++) {
        let t = i / dotCount;
        let angle = angleOffset + t * 360 * spiralTightness;
        let radius = 8 + t * maxRadius;

        let point = getPointOnCircle(centerX, centerY, radius, angle);

        let size = 1.8 + (1 - t) * 2.3 + random(-0.3, 0.3);
        if (size < 0.8) size = 0.8;

        let dot = createCircle(point.x, point.y, size, color);
        canvas.appendChild(dot);

        flowDots.push({
            element: dot,
            type: "swirl",
            centerX: centerX,
            centerY: centerY,
            baseRadius: radius,
            baseAngle: angle,
            offset: random(0, 100),
            baseSize: size
        });
    }
}

// =========================
// Tail swirl line - 尾部拉长版
// =========================
function createTailSwirlLine(centerX, centerY, maxRadius, angleOffset, spiralTightness, dotCount, color, stretchX, stretchY) {
    for (let i = 0; i < dotCount; i++) {
        let t = i / dotCount;
        let angle = angleOffset + t * 360 * spiralTightness;
        let radius = 12 + t * maxRadius;

        let basePoint = getPointOnCircle(centerX, centerY, radius, angle);

        let dx = (basePoint.x - centerX) * stretchX;
        let dy = (basePoint.y - centerY) * stretchY;

        let x = centerX + dx;
        let y = centerY + dy;

        let size = 1.5 + (1 - t) * 1.9 + random(-0.25, 0.25);
        if (size < 0.7) size = 0.7;

        let dot = createCircle(x, y, size, color);
        canvas.appendChild(dot);

        flowDots.push({
            element: dot,
            type: "tailSwirl",
            centerX: centerX,
            centerY: centerY,
            baseRadius: radius,
            baseAngle: angle,
            stretchX: stretchX,
            stretchY: stretchY,
            offset: random(0, 100),
            baseSize: size
        });
    }
}

// =========================
// Animation
// =========================
function animate() {
    time += 0.06;

    // 星星呼吸
    for (let i = 0; i < stars.length; i++) {
        let s = stars[i];
        let pulse = Math.sin(time * 1.8 + s.offset);

        let coreSize = s.baseSize + pulse * 0.35;
        if (coreSize < 0.7) coreSize = 0.7;

        s.core.setAttribute("r", coreSize);

        if (s.glow1) {
            s.glow1.setAttribute("r", s.baseSize * 2.4 + pulse * 0.9);
        }
        if (s.glow2) {
            s.glow2.setAttribute("r", s.baseSize * 1.6 + pulse * 0.6);
        }
    }

    // 流动点动画
    for (let i = 0; i < flowDots.length; i++) {
        let d = flowDots[i];

        if (d.type === "swirl") {
            let angle = d.baseAngle + time * 7 + Math.sin(time + d.offset) * 3;
            let radius = d.baseRadius + Math.sin(time * 1.4 + d.offset) * 2.5;

            let point = getPointOnCircle(d.centerX, d.centerY, radius, angle);
            let size = d.baseSize + Math.sin(time * 2 + d.offset) * 0.22;
            if (size < 0.6) size = 0.6;

            d.element.setAttribute("cx", point.x);
            d.element.setAttribute("cy", point.y);
            d.element.setAttribute("r", size);
        }

        if (d.type === "tailSwirl") {
            let angle = d.baseAngle + time * 6 + Math.sin(time + d.offset) * 2.6;
            let radius = d.baseRadius + Math.sin(time * 1.2 + d.offset) * 2.2;

            let basePoint = getPointOnCircle(d.centerX, d.centerY, radius, angle);

            let dx = (basePoint.x - d.centerX) * d.stretchX;
            let dy = (basePoint.y - d.centerY) * d.stretchY;

            let x = d.centerX + dx;
            let y = d.centerY + dy;

            let size = d.baseSize + Math.sin(time * 2 + d.offset) * 0.18;
            if (size < 0.55) size = 0.55;

            d.element.setAttribute("cx", x);
            d.element.setAttribute("cy", y);
            d.element.setAttribute("r", size);
        }

        if (d.type === "halo") {
            let angle = d.baseAngle + time * 3 + Math.sin(time + d.offset) * 1.4;
            let radius = d.baseRadius + Math.sin(time * 1.2 + d.offset) * 1.6;

            let point = getPointOnCircle(d.centerX, d.centerY, radius, angle);
            let size = d.baseSize + Math.sin(time * 2 + d.offset) * 0.15;
            if (size < 0.5) size = 0.5;

            d.element.setAttribute("cx", point.x);
            d.element.setAttribute("cy", point.y);
            d.element.setAttribute("r", size);
        }
    }

    // 楼房窗户轻微闪烁
    for (let i = 0; i < windows.length; i++) {
        let w = windows[i];
        let pulse = Math.sin(time * 1.5 + w.offset);

        let newWidth = w.baseWidth + pulse * 0.15;
        let newHeight = w.baseHeight + pulse * 0.2;

        if (newWidth < 3.4) newWidth = 3.4;
        if (newHeight < 5.2) newHeight = 5.2;

        w.element.setAttribute("width", newWidth);
        w.element.setAttribute("height", newHeight);
    }
}

clearButton.addEventListener('click', () => {
    clearCanvas(canvas);
    stars = [];
    flowDots = [];
    windows = [];
});

draw();
let animation = setInterval(animate, 50);
